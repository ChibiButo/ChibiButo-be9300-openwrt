# BE9300 test build: if the 2.4 GHz phy registered under a different
# device path than expected, re-point radio0 at it and restart Wi-Fi.
[ -s /etc/be9300-wifi-key ] && printf "\n*** BE9300 test Wi-Fi key: %s ***\n" "$(cat /etc/be9300-wifi-key)" > /dev/console
(
	sleep 60
	phy=$(ls /sys/class/ieee80211 2>/dev/null | head -n1)
	[ -n "$phy" ] || { logger -t be9300 "no wireless phy after 60s (see dmesg | grep -i -E 'ath11k|wcss|remoteproc')"; exit 0; }
	devpath=$(readlink -f /sys/class/ieee80211/$phy/device)
	want=$(uci -q get wireless.radio0.path)
	case "$devpath" in
	*"${want#platform/}") ;;
	*)
		newpath=$(echo "$devpath" | sed 's|^/sys/devices/||')
		logger -t be9300 "radio0 path $want -> $newpath"
		uci set wireless.radio0.path="$newpath"; uci commit wireless; wifi reload
		;;
	esac
) &
exit 0
