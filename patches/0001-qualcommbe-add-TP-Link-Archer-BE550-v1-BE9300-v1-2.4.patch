index 0000000000..d07a3bcc95
--- /dev/null
+++ b/package/kernel/mac80211/patches/ath11k/954-wifi-ath11k-ipq9574-set-max_tx_ring.patch
@@ -0,0 +1,23 @@
+From: ChibiButo <chibibuto@users.noreply.github.com>
+Subject: [PATCH] wifi: ath11k: ipq9574: set max_tx_ring
+
+The IPQ9574 hw_params entry leaves max_tx_ring at zero. ath11k_dp_tx()
+computes "ring_selector % ab->hw_params.max_tx_ring", so the first data
+frame transmitted on the integrated radio divides by zero, which matches
+the reported panic as soon as a client associates.
+
+IPQ9574's integrated radio uses the same TCL ring layout as IPQ8074, so
+use DP_TCL_NUM_RING_MAX like the IPQ8074 entry.
+
+Link: https://forum.openwrt.org/t/ipq9574-ath11k-support-patch-missing-max-tx-ring-kernel-panic-on-client-connect/246704
+---
+--- a/drivers/net/wireless/ath/ath11k/core.c
++++ b/drivers/net/wireless/ath/ath11k/core.c
+@@ -49,6 +49,7 @@
+ 			.cal_offset = 128 * 1024,
+ 		},
+ 		.max_radios = 1,
++		.max_tx_ring = DP_TCL_NUM_RING_MAX,
+ 		.bdf_addr = 0x4B700000,
+ 		.hw_ops = &ipq9574_ops,
+ 		.ring_mask = &ath11k_hw_ring_mask_ipq8074,
