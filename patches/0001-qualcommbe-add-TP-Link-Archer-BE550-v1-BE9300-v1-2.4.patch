diff --git a/package/kernel/mac80211/patches/ath11k/954-wifi-ath11k-ipq9574-set-max_tx_ring.patch b/package/kernel/mac80211/patches/ath11k/954-wifi-ath11k-ipq9574-set-max_tx_ring.patch
