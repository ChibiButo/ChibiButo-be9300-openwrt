diff --git a/target/linux/qualcommbe/ipq95xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata b/target/linux/qualcommbe/ipq95xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
new file mode 100755
index 0000000000..6917283282
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/etc/hotplug.d/firmware/11-ath11k-caldata
@@ -0,0 +1,26 @@
+#!/bin/sh
+
+[ -e /lib/firmware/$FIRMWARE ] && exit 0
+
+. /lib/functions/caldata.sh
+
+board=$(board_name)
+
+# The SMEM partition parser lowercases names; stock QSDK shows "0:ART".
+art_part() {
+	[ -n "$(find_mtd_part 0:art)" ] && echo "0:art" || echo "0:ART"
+}
+
+case "$FIRMWARE" in
+"ath11k/IPQ9574/hw1.0/cal-ahb-c000000.wifi.bin")
+	case "$board" in
+	tplink,archer-be550-v1)
+		# 2.4 GHz integrated radio; offset from TP-Link /sbin/is_cal
+		caldata_extract "$(art_part)" 0x1000 0x20000
+		;;
+	esac
+	;;
+*)
+	exit 1
+	;;
+esac
